# ─────────────────────────────────────────────────────────────
#  AI-Powered Ticket Triage System — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME="Ticket Triage System"
APP_ENV=development           # development | production
DEBUG=true

# ── API Security ─────────────────────────────────────────────
# Any long random string. Used as the X-API-Key header value.
API_KEY=change-me-to-a-strong-random-secret

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ticket_triage

# For Alembic (sync driver, used only during migrations)
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/ticket_triage

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── LLM Tuning ───────────────────────────────────────────────
LLM_TEMPERATURE=0.1          # Low temperature for consistent classification
LLM_MAX_TOKENS=1024
LLM_RETRY_ATTEMPTS=2

# ── RAG ──────────────────────────────────────────────────────
RAG_TOP_K=5                  # Number of knowledge articles to retrieve

# ── Pagination ───────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Ticket Validation ────────────────────────────────────────
TICKET_SUBJECT_MAX_LEN=200
TICKET_DESCRIPTION_MAX_LEN=5000

